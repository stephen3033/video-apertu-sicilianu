# Cloudflare deployment inputs. This file contains intentionally invalid placeholders.
# Copy only relevant variables to a private .env; never commit real credentials.
# Terraform uses TF_VAR_*; op run resolves op:// values for the command it launches.
TF_VAR_cloudflare_account_id=REPLACE_WITH_32_CHARACTER_ACCOUNT_ID
TF_VAR_environment=preview
TF_VAR_app_origin=https://REPLACE_WITH_PREVIEW_APPLICATION_HOST
TF_VAR_email_from=REPLACE_WITH_EMAIL_AT_RESEND_VERIFIED_DOMAIN
# Repeat with production origin/environment and separate Terraform state.
# Deploy token: Workers, assets, queues, R2 and D1 provisioning within this account.
CLOUDFLARE_API_TOKEN=op://REPLACE_VAULT/Cloudflare deployment/token
# Put this separate credential in .env.admin for direct SQL and migrations.
# It must not be uploaded to Worker secrets or used by the application.
CLOUDFLARE_DATABASE_ADMIN_TOKEN=op://REPLACE_VAULT/Cloudflare database administration/token
# Runtime secrets. scripts/secrets.mjs sends ONLY this explicit allowlist to Wrangler.
# A random secret of at least 32 bytes, used for code/IP HMACs (not a session signing key).
AUTH_CODE_SECRET=op://REPLACE_VAULT/Video Apertu authentication/hmac secret
# R2 S3 credentials scoped to the corresponding environment's private staging bucket.
R2_ACCESS_KEY_ID=op://REPLACE_VAULT/Video Apertu staging/access key id
R2_SECRET_ACCESS_KEY=op://REPLACE_VAULT/Video Apertu staging/secret access key
# Internet Archive account permitted to create the intended public audio/video items.
IA_ACCESS_KEY=op://REPLACE_VAULT/Internet Archive/access key
IA_SECRET_KEY=op://REPLACE_VAULT/Internet Archive/secret key
# Sending-only API key; EMAIL_FROM must use a domain already verified in Resend.
RESEND_API_KEY=op://REPLACE_VAULT/Resend/api key
# Optional script selectors (ordinary paths, not secret values).
VAS_SECRET_REFS=.env
VAS_ADMIN_REFS=.env.admin
